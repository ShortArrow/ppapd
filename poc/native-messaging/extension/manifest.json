{
  "manifest_version": 3,
  "name": "ppapd PoC native messaging",
  "version": "0.0.3",
  "description": "Sends mail-open and mail-list events from Outlook on the web to a local Native Messaging host and marks the IDs it answers with.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
